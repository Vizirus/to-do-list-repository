@using Microsoft.AspNetCore.Mvc.Rendering
@model TaskEditViewModel
@{
    ViewData["Title"] = "Edit task";
    var taskId = (int)(ViewData["TaskId"] ?? 0);
    var users = ViewData["Users"] as SelectList;
    var statuses = ViewData["Statuses"] as SelectList;
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Edit task</h4>
        <form method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ListId" />

            <div class="mb-3">
                <label asp-for="TaskName" for="TaskName" class="form-label">Task name</label>
                <input asp-for="TaskName" id="TaskName" class="form-control" />
                <span asp-validation-for="TaskName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TaskDescription" for="TaskDescription" class="form-label">Description</label>
                <textarea asp-for="TaskDescription" id="TaskDescription" class="form-control" rows="4"></textarea>
                <span asp-validation-for="TaskDescription" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TaskStartDate" for="TaskStartDate" class="form-label">Start date</label>
                    <input asp-for="TaskStartDate" id="TaskStartDate" class="form-control" />
                    <span asp-validation-for="TaskStartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TaskFinishDate" for="TaskFinishDate" class="form-label">Finish date</label>
                    <input asp-for="TaskFinishDate" id="TaskFinishDate" class="form-control" />
                    <span asp-validation-for="TaskFinishDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StatusId" for="StatusId" class="form-label">Status</label>
                    <select asp-for="StatusId" id="StatusId" class="form-select" asp-items="statuses"></select>
                    <span asp-validation-for="StatusId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="AssigndUserId" for="AssigndUserId" class="form-label">Assignee</label>
                    <select asp-for="AssigndUserId" id="AssigndUserId" class="form-select" asp-items="users"></select>
                    <span asp-validation-for="AssigndUserId" class="text-danger"></span>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Save</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@taskId">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
