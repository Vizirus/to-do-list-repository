@using WebMvc.Api.Dtos
@model ShareListViewModel
@{
    ViewData["Title"] = "Share list";
    var users = ViewData["Users"] as IReadOnlyList<UserDto> ?? Array.Empty<UserDto>();
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Share list #@Model.ToDoListId</h4>
        <form method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ToDoListId" />

            <div class="mb-3">
                <label asp-for="AssignedUserId" id="AssignedUserId" class="form-label">Assigned user id</label>
                <select asp-for="AssignedUserId" class="form-select">
                    <option value="">Select user…</option>
                    @foreach (var u in users)
                    {
                        <option value="@u.Id">@u.Username (@u.Email)</option>
                    }
                </select>
                <span asp-validation-for="AssignedUserId" class="text-danger"></span>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="d-flex gap-2">
                <button class="btn btn-success" type="submit">Share</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.ToDoListId">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
