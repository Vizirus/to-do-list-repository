@using WebMvc.Api.Dtos
@using WebMvc.Services
@model PagedResult<ListDto>
@{
    ViewData["Title"] = "To-do lists";
    var sharedLists = ViewData["SharedLists"] as IReadOnlyList<ListDto> ?? Array.Empty<ListDto>();
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">To-do lists</h2>
        <div class="text-muted small">Manage your lists and shared lists.</div>
    </div>
    <a class="btn btn-primary" asp-action="Create">New list</a>
</div>

@if (sharedLists.Count > 0)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Shared with you</h5>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                @foreach (var list in sharedLists)
                {
                    <div class="col">
                        <div class="border rounded-3 p-3 bg-white">
                            <div class="fw-semibold">@list.ListName</div>
                            <div class="text-muted small">List #@list.Id</div>
                            <div class="mt-2">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@list.Id">Open</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Your lists</h5>

        @if (Model.Items.Count == 0)
        {
            <div class="text-muted">No lists yet.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                @foreach (var list in Model.Items)
                {
                    <div class="col">
                        <div class="border rounded-3 p-3 bg-white">
                            <div class="fw-semibold">@list.ListName</div>
                            <div class="text-muted small">Created @list.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd") • List #@list.Id</div>
                            <div class="mt-2 d-flex gap-2">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@list.Id">Open</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@list.Id">Edit</a>
                                <a class="btn btn-sm btn-outline-success" asp-action="Share" asp-route-id="@list.Id">Share</a>
                                <form asp-action="Delete" asp-route-id="@list.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Delete this list?')">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3 d-flex align-items-center justify-content-between">
                <div class="text-muted small">Page @Model.Page of @Model.TotalPages • @Model.TotalCount total</div>
                <div class="btn-group">
                    <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">Prev</a>
                    <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
                </div>
            </div>
        }
    </div>
</div>
