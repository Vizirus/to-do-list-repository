@model ListEditViewModel
@{
    ViewData["Title"] = "New list";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Create list</h4>
        <form asp-action="Create" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="ListName" for="ListName" class="form-label">List name</label>
                <input asp-for="ListName" id="ListName" class="form-control" autocomplete="off" />
                <span asp-validation-for="ListName" class="text-danger"></span>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Create</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

