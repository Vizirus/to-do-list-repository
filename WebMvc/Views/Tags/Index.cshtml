@model TagsIndexViewModel
@{
    ViewData["Title"] = "Tags";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">Tags</h2>
        <div class="text-muted small">All tags used in tasks.</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Add tag</h5>
                <form asp-action="Create" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="NewTag.Name" for="NewTag_Name" class="form-label">Name</label>
                        <input asp-for="NewTag.Name" id="NewTag_Name" class="form-control" />
                        <span asp-validation-for="NewTag.Name" class="text-danger"></span>
                    </div>
                    <button class="btn btn-success" type="submit">Create</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">All tags</h5>

                @if (Model.Tags.Count == 0)
                {
                    <div class="text-muted">No tags yet.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var tag in Model.Tags)
                        {
                            <a class="badge badge-soft text-decoration-none" asp-action="Details" asp-route-id="@tag.Id">@tag.Name</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
